generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Scene {
  id String @id
  name String
  asset String
  targets Target[]
  rounds Round[]
}
model Target {
  id String @id
  name String
  symbol String
  x Float
  y Float
  width Float
  height Float
  sceneId String
  scene Scene @relation(fields: [sceneId], references: [id])
  finds Find[]
  @@index([sceneId])
}
model Round {
  id String @id @default(uuid())
  credentialHash String @unique
  startedAt DateTime @default(now())
  completedAt DateTime?
  sceneId String
  scene Scene @relation(fields: [sceneId], references: [id])
  finds Find[]
  score Score?
  @@index([sceneId])
}
model Find {
  roundId String
  targetId String
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  target Target @relation(fields: [targetId], references: [id])
  @@id([roundId, targetId])
  @@index([targetId])
}
model Score {
  id Int @id @default(autoincrement())
  name String
  elapsedMs Int
  createdAt DateTime @default(now())
  roundId String @unique
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  @@index([elapsedMs, createdAt, id])
}
